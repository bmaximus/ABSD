{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "manager",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(python3 absd/tooling/coverage_gate.py:*)",
      "Bash(python3 absd/tooling/traceability_report.py:*)",
      "Bash(python3 absd/tooling/trace_check.py:*)",
      "Bash(python3 absd/tooling/ownership_check.py:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/absd/tooling/ownership_hook.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
